{
  "name": "@ticketfairy/wordpress-plugin",
  "version": "2.0.0",
  "private": true,
  "description": "Block editor bundle for the Ticket Fairy Events WordPress plugin",
  "scripts": {
    "build": "node build.mjs",
    "test": "php tests/run.php",
    "typecheck": "tsc --noEmit",
    "zip": "node build.mjs && cd ticket-fairy-events && zip -rq ../ticket-fairy-events.zip . -x '*.DS_Store'"
  },
  "dependencies": {
    "@ticketfairy/site-embed-core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "typescript": "5.6.3"
  }
}
