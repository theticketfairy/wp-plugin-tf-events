# The Wix build (`wix build` in wix/) resolves imports such as @wix/sdk-context
# from the app folder, not from the package that imports them. Hoist the @wix
# packages so it finds them. The first two lines keep pnpm's defaults.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@wix/*
